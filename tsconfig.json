{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    
    /* Module Resolution */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    
    /* Type Checking */
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    
    /* Emit */
    "declaration": false,
    "sourceMap": false,
    "outDir": "./dist",
    "removeComments": true,
    
    /* Interop Constraints */
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "temp"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
